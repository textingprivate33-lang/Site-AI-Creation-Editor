# Copy this file to ".env" and fill in your key. NEVER commit ".env".
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Voice for narration. Nigerian English: en-NG-EzinneNeural (female) or en-NG-AbeoNeural (male)
TTS_VOICE=en-US-AndrewNeural

# Contact details shown at the end of the video. Fill in what you have, leave the rest empty.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_TELEGRAM=
CONTACT_TIKTOK=
CONTACT_FACEBOOK=
CONTACT_INSTAGRAM=
